{
  "name": "monorepo-template",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter './apps/*' dev",
    "build": "bun run --filter './apps/*' --if-present build",
    "test": "bun run test:workspaces && bun run test:rules",
    "test:workspaces": "bun run --workspaces --if-present test",
    "test:rules": "bun test tooling",
    "prepare": "hk install >/dev/null 2>&1 || true",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "check": "bun run check:boundaries && bun run check:env && bun run lint && bun run format:check",
    "check:fix": "bun run lint:fix && bun run format",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "with-env": "dotenv -e .env --",
    "createsuperuser": "bun run --filter @repo/api createsuperuser",
    "db:generate": "bun run --filter @repo/db db:generate",
    "db:deploy": "bun run --filter @repo/db db:deploy",
    "db:migrate": "bun run --filter @repo/db db:migrate",
    "db:push": "bun run --filter @repo/db db:push",
    "db:studio": "bun run --filter @repo/db db:studio",
    "db:check": "bun run --filter @repo/db db:check",
    "deploy:web": "bun run --filter @repo/web deploy",
    "deploy:dry-run": "bun run --filter @repo/web deploy:dry-run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:env": "tsx scripts/check-env.ts"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "trustedDependencies": [
    "esbuild",
    "msgpackr-extract",
    "workerd"
  ]
}
