{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "db:generate": "bun run with-env drizzle-kit generate",
    "db:deploy": "bun run with-env drizzle-kit migrate",
    "db:migrate": "bun run db:deploy",
    "db:push": "bun run with-env drizzle-kit push",
    "db:studio": "bun run with-env drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:"
  }
}
