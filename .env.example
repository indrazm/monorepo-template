NODE_ENV="development"
API_PORT="8000"
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/tacto"
REDIS_URL="redis://localhost:16379"
# Password for the Compose PostgreSQL service. Also substituted into the
# default DOCKER_DATABASE_URL below, so overriding DOCKER_DATABASE_URL is
# only needed for a non-Compose database.
POSTGRES_PASSWORD="postgres"
DOCKER_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/tacto"
DOCKER_REDIS_URL="redis://redis:6379"
API_HOST_PORT="8000"
VITE_API_URL="http://localhost:8000"
# Public API URL shown to users in copyable webhook/ingest snippets (a tunnel in
# development, the real API host in production). Falls back to VITE_API_URL.
VITE_PUBLIC_API_URL=""
BETTER_AUTH_SECRET=""
# Public API origin. Verification and password-reset links are built from this,
# so in production/dev-with-a-tunnel it must be the internet-reachable URL
# (e.g. https://xxxx.ngrok-free.app), not localhost.
BETTER_AUTH_URL="http://localhost:8000"
# Comma-separated web origins allowed to talk to the API. Must include every
# public dashboard origin (localhost + the deployed web app), because the
# verification/reset callback URL is checked against this list.
CLIENT_ORIGINS="http://localhost:3000"
VITE_WIDGET_CDN_URL="http://localhost:8080"
# In-app support (feedback T16). All optional — the help center always works.
# Crisp live-chat website id (https://app.crisp.chat → Settings → Website ID).
VITE_CRISP_WEBSITE_ID=""
# "Book a setup call" link (e.g. a Calendly URL). Shown when set.
VITE_SUPPORT_CALL_URL=""
# Video guides link (playlist/landing). Shown when set.
VITE_SUPPORT_VIDEO_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Price IDs from the Dashboard (https://dashboard.stripe.com/prices), one per paid plan.
# Monthly prices:
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_AGENCY=""
# Annual prices (optional — enables the monthly/annual toggle, feedback T11):
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_AGENCY_ANNUAL=""
# Free-trial length in days applied at checkout (feedback T11). Blank/0 = no trial.
STRIPE_TRIAL_DAYS=""
# Tacto-level app credentials for OAuth connectors. Per-organization provider
# credentials are stored encrypted in the database, not here.
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# --- Reviews & social proof (feedback T6/T7) --------------------------------
# Optional. Without these, reviews are added manually or via CSV import, and
# social/YouTube counters use the number you type. Set them to enable live
# import/refresh.
# Google Places API key (Places Details → reviews). https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=""
# Facebook Page access token (Graph API ratings). https://developers.facebook.com/
FACEBOOK_PAGE_TOKEN=""
# YouTube Data API v3 key (channel statistics). https://console.cloud.google.com/
YOUTUBE_API_KEY=""
# --- Integration connectors -------------------------------------------------
# Public, internet-reachable base URL of this API. Providers (Stripe, Shopify,
# Calendly) must be able to POST to it, so in development use an ngrok/Cloudflare
# tunnel URL here rather than localhost.
PUBLIC_API_URL=""
# Encrypts per-organization integration credentials at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32. Falls back to BETTER_AUTH_SECRET if unset.
CREDENTIALS_SECRET=""
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For (e.g. the
# Docker/Caddy network). Leave blank for local development.
TRUSTED_PROXIES=""
# Bearer token for /metrics. Unset = metrics disabled in production.
METRICS_TOKEN=""
# Optional keyed static-map provider for the notification media fallback.
# Placeholders {lat} and {lng} are substituted. Unset = no map fallback.
STATIC_MAP_URL_TEMPLATE=""

# Outbound email via Resend (https://resend.com). Uses the HTTP API, not SMTP.
# Required in production: the API refuses to start without a key and sender.
RESEND_API_KEY=""
# Sender address. The domain must be verified in Resend (SPF/DKIM/DMARC).
MAIL_FROM_EMAIL="no-reply@tacto.software"
# Display name in the From header. Defaults to "Tacto".
MAIL_FROM_NAME="Tacto"
# Optional full send endpoint (e.g. an EU region or proxy).
# Defaults to https://api.resend.com/emails.
RESEND_API_URL=""
# Token lifetimes in seconds. Blank = defaults (verification 3600, reset 3600).
EMAIL_VERIFICATION_EXPIRES_IN=""
PASSWORD_RESET_EXPIRES_IN=""
