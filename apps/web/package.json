{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "deploy": "pnpm --filter @repo/widget build && pnpm run build && node scripts/publish-pixel.mjs && wrangler deploy",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "preview:cloudflare": "pnpm --filter @repo/widget build && pnpm run build && node scripts/publish-pixel.mjs && wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@repo/api-client": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "better-auth": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "catalog:",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
