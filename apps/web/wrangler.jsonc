{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tacto-web",
  "compatibility_date": "2026-08-11",
  "routes": [
    {
      "pattern": "app.tacto.software",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "dev": {
    "port": 3000,
  },
}
